From 0acad4f87a946511834e0411ae0a633fee6a1dc8 Mon Sep 17 00:00:00 2001
From: Ishan Chattopadhyaya <ishan@apache.org>
Date: Tue, 20 Oct 2026 19:36:48 +0530
Subject: [PATCH 2/4] query: skip term windows without docs when counting

Without a window filter, TermBulkScorer's count and match windows now
start at the window holding the term's next doc instead of stepping
through every window in order, so counting a rare term under a filter no
longer walks thousands of windows that hold none of its docs.
---
 src/luxir/query/TermQuery.h | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/luxir/query/TermQuery.h b/src/luxir/query/TermQuery.h
index 4633736a..26b7ba02 100644
--- a/src/luxir/query/TermQuery.h
+++ b/src/luxir/query/TermQuery.h
@@ -1249,6 +1249,20 @@ public:
       }
     }
 
+    // Where the next window with any of the term's docs starts: the term's next doc at or after
+    // min, word-aligned (but not before min); max when it has none before max. The windows
+    // skipped hold none of its docs, so they count and match nothing. Only without a window
+    // filter, which may prepare windows in order.
+    int32_t firstTermWindow(int32_t min, int32_t max) {
+      if (windowFilter != nullptr) return min;
+      std::span<const int32_t> next = scorer->docsEnum.peekDocOnlyBlock();
+      if (next.empty()) return max;
+      auto it = std::lower_bound(next.begin(), next.end(), min);
+      if (it == next.end()) return min;  // the decoded block ends before min: the fill skips
+      if (*it >= max) return max;
+      return std::max(min, *it & ~63);
+    }
+
   public:
     TermBulkScorer(MemPool& pool, TermQuery::Scorer* scorer, int32_t maxDoc)
         : scorer(scorer),
@@ -1300,6 +1314,10 @@ public:
       if (filter != nullptr && filter->card() == 0) {
         return PostingsReader::END;
       }
+      min = firstTermWindow(min, max);
+      if (min >= max) {
+        return PostingsReader::END;
+      }
 
       setWindowBounds(min, max);
       if (!fillFilteredWindowBits(filter)) {
@@ -1338,6 +1356,11 @@ public:
       if (filter != nullptr && filter->card() == 0) {
         return PostingsReader::END;
       }
+      min = firstTermWindow(min, max);
+      if (min >= max) {
+        out.min = out.max = max;
+        return PostingsReader::END;
+      }
 
       setWindowBounds(min, max);
       out.min = windowStart;
-- 
