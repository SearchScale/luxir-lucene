From 78f46a4c26188e0a0974df28e39029629fcea888 Mon Sep 17 00:00:00 2001
From: Ishan Chattopadhyaya <ishan@searchscale.com>
Date: Mon, 26 Oct 2026 00:05:27 +0530
Subject: [PATCH 7/7] query: ordered span-near matching in the phrase scorer

A PhraseQuery built with ordered=true matches and scores like Lucene's
ordered SpanNearQuery over single distinct terms (NearSpansOrdered under
SpanScorer): each position of the first term starts at most one match, later
terms only move forward to their first position at or after the previous
term's end, a match counts when the gaps add up to at most slop, and it adds
1 / (1 + gaps) to the frequency; a term running out of positions ends the
document. Scoring, impacts and bounds are the sloppy scorer's. The exact
phrase route for sparse filtered top-k excludes it.
---
 src/luxir/query/BooleanWeight.h |   3 +-
 src/luxir/query/PhraseQuery.h   | 159 +++++++++++++++++++++++++++++++-
 2 files changed, 158 insertions(+), 4 deletions(-)

diff --git a/src/luxir/query/BooleanWeight.h b/src/luxir/query/BooleanWeight.h
index 2a312ca2..043754de 100644
--- a/src/luxir/query/BooleanWeight.h
+++ b/src/luxir/query/BooleanWeight.h
@@ -7672,7 +7672,8 @@ class BooleanQuery::Weight final : public Query::Weight {
       return true;
     }
     return query->getKind() == QueryKind::PHRASE
-        && static_cast<PhraseQuery*>(query)->getSlop() == 0;
+        && static_cast<PhraseQuery*>(query)->getSlop() == 0
+        && !static_cast<PhraseQuery*>(query)->isOrdered();
   }
 
   static bool lessMaxScore(float a, float b) {
diff --git a/src/luxir/query/PhraseQuery.h b/src/luxir/query/PhraseQuery.h
index 35a9c31e..e4cff66d 100644
--- a/src/luxir/query/PhraseQuery.h
+++ b/src/luxir/query/PhraseQuery.h
@@ -24,6 +24,9 @@ class PhraseQuery final : public Query {
   std::span<std::string_view> terms;
   std::span<const int32_t> positions;
   int32_t slop;
+  // Lucene's ordered SpanNearQuery over single distinct terms instead of a
+  // phrase: matched and scored by OrderedMatcher.
+  bool ordered;
 
 public:
   bool recoverableAsPredicate() const noexcept override { return true; }
@@ -53,9 +56,11 @@ public:
 
   class ExactMatcher;
   class SloppyMatcher;
+  class OrderedMatcher;
   template<class MatcherPolicy> class PhraseScorer;
   using Scorer = PhraseScorer<ExactMatcher>;
   using SloppyScorer = PhraseScorer<SloppyMatcher>;
+  using OrderedScorer = PhraseScorer<OrderedMatcher>;
 
 private:
   struct EstimateCalculation {
@@ -299,17 +304,24 @@ private:
 public:
 
   PhraseQuery(std::string_view field, std::span<std::string_view> terms,
-              std::span<const int32_t> positions, int32_t slop = 0)
+              std::span<const int32_t> positions, int32_t slop = 0, bool ordered = false)
       : Query(QueryKind::PHRASE), field(field), terms(terms),
-        positions(positions), slop(slop) {
+        positions(positions), slop(slop), ordered(ordered) {
     assert(terms.size() == positions.size());
     assert(terms.size() >= 2);
     assert(slop >= 0);
+#ifndef NDEBUG
+    if (ordered) {
