From 0ee57c5dc946f71d7784e98acdf76d7a056974ec Mon Sep 17 00:00:00 2001
From: Ishan Chattopadhyaya <ishan@searchscale.com>
Date: Mon, 26 Oct 2026 00:05:27 +0530
Subject: [PATCH 6/7] reader: resume a DFA intersection after a start term

DfaScanPlan takes an optional startAfter: the scan then starts at the later
of the automaton's prefix and the start term, and returns only accepted terms
that sort strictly after it. Lucene's FuzzyTermsEnum restarts its
intersection this way whenever its competitive bound tightens; without it the
caller had to walk the dictionary through a generic seek per step.
---
 src/luxir/reader/DfaIntersectEnum.h    | 13 ++++++++-
 test/basic_tests/AutomatonSeekTest.cpp | 38 ++++++++++++++++++++++++--
 2 files changed, 48 insertions(+), 3 deletions(-)

diff --git a/src/luxir/reader/DfaIntersectEnum.h b/src/luxir/reader/DfaIntersectEnum.h
index c299f46e..969d4895 100644
--- a/src/luxir/reader/DfaIntersectEnum.h
+++ b/src/luxir/reader/DfaIntersectEnum.h
@@ -7,6 +7,7 @@
 #include <assert.h>
 #include <compare>
 #include <cstring>
+#include <optional>
 #include <string_view>
 
 #include "AutomatonSeekCore.h"
@@ -19,6 +20,10 @@ struct DfaScanPlan {
   std::string_view prefix;
   std::string_view commonSuffix;
   automaton::ByteDfaView::State initialState;
+  // When set, enumeration resumes after this term: only accepted terms that
+  // sort strictly after it are returned (a restarted scan, as Lucene's
+  // FuzzyTermsEnum does whenever its competitive bound tightens).
+  std::optional<std::string_view> startAfter = std::nullopt;
 };
 
 // Byte-DFA dictionary intersection.  Outside a detected cyclic range this is
@@ -31,6 +36,7 @@ class DfaIntersectEnum final : public AutomatonSeekCore<automaton::ByteDfaView>
   using typename Core::MatchStatus;
 
   std::string_view commonSuffix;
+  std::optional<std::string_view> startAfter;
   uint32_t* visitedStates;
   uint32_t visitedGeneration = 0;
   char linearUpper[PackedTerm::MAX_LEN + 1];
@@ -259,7 +265,11 @@ class DfaIntersectEnum final : public AutomatonSeekCore<automaton::ByteDfaView>
 
   bool seekStart(SmartScan& s) {
     resetStack(s);
-    return te.seekCeil(prefix);
+    if (!startAfter || *startAfter < prefix) return te.seekCeil(prefix);
+    // Terms below the prefix cannot match, so the later of the two bounds is
+    // where the scan starts; the start term itself is excluded.
+    if (!te.seekCeil(*startAfter)) return false;
+    return te.term() != *startAfter || te.nextTerm();
   }
 
   template<bool USE_LINEAR, bool TOTAL_TRANSITION_SCAN = false>
@@ -331,6 +341,7 @@ public:
   DfaIntersectEnum(MemPool& pool, TermsEnum& te, A automaton, DfaScanPlan plan)
       : Core(pool, te, plan.prefix, automaton, plan.initialState),
         commonSuffix(plan.commonSuffix),
+        startAfter(plan.startAfter),
         visitedStates((uint32_t*)pool.alloc(automaton.size() * sizeof(*visitedStates),
                                             alignof(uint32_t))),
         totalTransitionScan(automaton.allStatesLiveOnAllBytes()) {
diff --git a/test/basic_tests/AutomatonSeekTest.cpp b/test/basic_tests/AutomatonSeekTest.cpp
index 87d268a8..574b3b45 100644
--- a/test/basic_tests/AutomatonSeekTest.cpp
+++ b/test/basic_tests/AutomatonSeekTest.cpp
@@ -4,6 +4,7 @@
 #include <gtest/gtest.h>
 
 #include <algorithm>
+#include <optional>
 #include <random>
 #include <string>
 #include <vector>
@@ -41,14 +42,15 @@ void addTerms(TestIndex& index, TestField& field, const std::vector<std::string>
 }
 
 std::vector<std::string> collectSmart(TestField& field, const ByteDfa& dfa, int64_t* examined = nullptr,
-                                      int64_t* jumps = nullptr, DfaStats* stats = nullptr) {
+                                      int64_t* jumps = nullptr, DfaStats* stats = nullptr,
+                                      std::optional<std::string_view> startAfter = std::nullopt) {
   auto guard = field.testIndex.pool.rewindScopeGuard();
   auto* segment = field.currentSegment();
   TermsEnum terms(guard.pool(), segment->postingsReader(), field.fieldInfo);
   auto view = dfa.view();
   auto [prefix, state] = view.commonPrefixAndState();
   std::string commonSuffix = dfa.commonSuffix();
-  DfaScanPlan plan{prefix, commonSuffix, state};
+  DfaScanPlan plan{prefix, commonSuffix, state, startAfter};
   DfaIntersectEnum e(guard.pool(), terms, view, plan);
   std::vector<std::string> out;
   while (e.next()) out.emplace_back(e.termView());
@@ -137,6 +139,38 @@ TEST_F(AutomatonSeekTest, WildcardDifferentialAndLowerBound) {
   }
 }
 
+// A scan resumed after a start term (exclusive) returns exactly the accepted
+// terms that sort after it, wherever the start falls: on a term, between
+// terms, before the automaton's prefix, past every term, or empty.
+TEST_F(AutomatonSeekTest, StartAfterDifferential) {
+  std::mt19937 rng(0x5ea7af);
+  TestIndex index;
+  TestField field(index, "value_s");
+  std::vector<std::string> terms = corpus(rng);
+  addTerms(index, field, terms);
+  std::sort(terms.begin(), terms.end());
+  for (int i = 0; i < 300; i++) {
+    Budget budget(10000000);
+    bool regex = i % 3 == 0;
+    std::string text = regex ? std::string(i % 2 ? "(app|ban).*a" : "[ab]*c") : pattern(rng);
+    ByteDfa dfa = regex ? compileRegex(text, budget) : compileWildcard(text, budget);
+    std::string start;
+    switch (rng() % 5) {
+      case 0: start = terms[rng() % terms.size()]; break;
+      case 1: start = terms[rng() % terms.size()] + std::string(1, '\0'); break;
+      case 2: start = "a"; break;
+      case 3: start = "\xff\xff"; break;
+      default: start = ""; break;
+    }
+    std::vector<std::string> expected;
+    for (const std::string& term : collectBrute(field, dfa)) {
+      if (std::string_view(term) > std::string_view(start)) expected.push_back(term);
+    }
+    EXPECT_EQ(collectSmart(field, dfa, nullptr, nullptr, nullptr, start), expected)
+        << text << " after '" << start << "'";
+  }
+}
+
 TEST_F(AutomatonSeekTest, SparseWildcardJumps) {
   TestIndex index;
   TestField field(index, "value_s");
-- 
